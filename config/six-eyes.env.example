# Copy to .env or export in your shell (not loaded automatically).

# offline | live — offline reads sample-inputs/ for Jira and meetings
export SIX_EYES_MODE=offline

export SIX_EYES_BQ_PROJECT=your-gcp-project
export SIX_EYES_BQ_DATASET=acme_analytics

# Optional path to a sibling governed metrics repo (see docs/governed-knowledge-promotion.md)
# export GOVERNED_REPO=/path/to/governed-metrics-repo

# MCP tool-name prefixes used by scripts/agent-pipeline-run.sh to build its
# --allowedTools / --disallowedTools lists. `mcp__<server name>` for a server in
# .mcp.json / .cursor/mcp.json; `mcp__<connector uuid>` for a claude.ai connector.
# export SIX_EYES_MCP_ATLASSIAN=mcp__atlassian
# export SIX_EYES_MCP_SLACK=mcp__slack
